{
  "name": "qtoh",
  "description": "Redirects QRZ callsign lookups to HamQTH.",
  "private": true,
  "version": "1.1",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",

{
  "name": "Q to H",
  "version": "1.0",
  "manifest_version": 3,
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "@qtoh.cniesen",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  
  "action": {
    "default_icon": {
      "16": "buttons/qtoh-enabled-16.png",
      "32": "buttons/qtoh-enabled-32.png"
    },
    "default_title": "__MSG_extensionButtonTitle__",
    "theme_icons": [{
      "light": "icons/qtoh-16-light.png",
      "dark": "icons/qtoh-16.png",
      "size": 16
    }, {
      "light": "icons/qtoh-32-light.png",
      "dark": "icons/qtoh-32.png",
      "size": 32
    }]
  },
  "background": {
	"scripts": ["background.js"],
    "service_worker": "background.js"
  },

  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "permissions": [
    "management",
	"notifications",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": ["http://www.qrz.com/", "https://www.qrz.com/"]
}